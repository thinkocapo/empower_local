# Empower Local configuration.
# Copy this file to `.env` and fill in your Sentry DSNs. That's the only required step.
#
#   cp .env.template .env
#
# Find your DSNs in Sentry under: Settings -> Projects -> [project] -> Client Keys (DSN)

# ============================================================
# REQUIRED — your Sentry DSNs (one per project)
# (Optional in Spotlight mode — see README "Spotlight mode". Leave blank to run
#  fully local with no Sentry.io account.)
# ============================================================
REACT_APP_DSN=
FLASK_DSN=

# ============================================================
# OPTIONAL — enable React source-map upload at build time.
# Set all three to get readable (un-minified) stack traces in Sentry.
# Leave blank to skip upload entirely (the build still works).
# ============================================================
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
REACT_SENTRY_PROJECT=

# ============================================================
# OPTIONAL — overrides (safe defaults already exist)
# ============================================================
# Environment tag shown in Sentry
REACT_APP_ENVIRONMENT=local
FLASK_ENVIRONMENT=local

# Release names (used for release health + source-map association)
REACT_APP_RELEASE=empower-local-react@1.0.0
FLASK_RELEASE=empower-local-flask@1.0.0

# Where the browser reaches Flask. This is the BROWSER's view, so it must be
# localhost (not the docker service name).
REACT_APP_BACKEND_URL_FLASK=http://localhost:8080

# Set to "false" for snappier /products responses (disables the deliberate
# CPU-heavy slow-profile loop used to demo profiling).
RUN_SLOW_PROFILE=true
